# Server
SERVER_PORT=8000

# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# Retries
RETRY_DELAY=2
MAX_RETRIES=3

# Workers
WORKER_IDLE_TIMEOUT=30
WORKER_COUNT=4

# Logging
LOG_FILE_PATH=chat.log

# API Keys (required when LLM_PROVIDER is openai, anthropic, or gemini)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Gemini (free): https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSy...your_key_here
